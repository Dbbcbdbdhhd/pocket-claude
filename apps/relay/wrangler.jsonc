{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pocket-claude-relay",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "ACCOUNTS", "class_name": "AccountDO" },
      { "name": "PAIRINGS", "class_name": "PairingDO" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AccountDO", "PairingDO"] }]
}
